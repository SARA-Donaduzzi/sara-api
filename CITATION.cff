cff-version: 1.2.0
title: "SARA: Sistema de Avaliação e Revisão de Artigos"
message: "Se você usar este software em trabalho acadêmico, por favor cite-o conforme os metadados abaixo."
type: software
authors:
  - given-names: "Matheus Felipe"
    family-names: "Queiroz Pinto"
    affiliation: "Faculdade Donaduzzi"
    email: "matheus.pinto@alunos.bpkedu.com.br"
  - given-names: "Willian Douglas"
    family-names: "Ferrari Mendonça"
    affiliation: "Faculdade Donaduzzi"
    email: "willian.mendonca@bpkedu.com.br"
repository-code: "https://github.com/SARA-Donaduzzi/sara-api"
abstract: >-
  Plataforma de submissão e avaliação por pares de artigos acadêmicos,
  com um módulo de interoperabilidade OAI-PMH 2.0 que expõe os trabalhos
  aprovados em Dublin Core e um módulo de recomendação de avaliadores
  baseado em similaridade semântica entre embeddings multilíngues.
keywords:
  - peer review
  - OAI-PMH
  - Dublin Core
  - reviewer assignment
  - sentence embeddings
  - open science
license: MIT
preferred-citation:
  type: conference-paper
  title: "SARA como Infraestrutura Científica Aberta: Recomendação Semântica de Avaliadores e Interoperabilidade via OAI-PMH"
  authors:
    - given-names: "Matheus Felipe"
      family-names: "Queiroz Pinto"
      affiliation: "Faculdade Donaduzzi"
    - given-names: "Willian Douglas"
      family-names: "Ferrari Mendonça"
      affiliation: "Faculdade Donaduzzi"
  conference:
    name: "Latinoware 2026 - 23º Congresso Latino-americano de Software Livre e Tecnologias Abertas (trilha Latin.Science)"
  year: 2026
