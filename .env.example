# Copie este arquivo para .env e preencha com os seus valores.
# Todos os valores abaixo sao ficticios e servem apenas de exemplo.
# NUNCA use estes valores em um ambiente exposto na rede.

# Servidor
PORT=8080
NODE_ENV=development

# Banco de dados
# Em desenvolvimento, o docker-compose.yml sobe o PostgreSQL na porta 5433.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5433/sara_db?schema=public"

# JWT
# Gere um segredo aleatorio e longo, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GERE_UM_SEGREDO_ALEATORIO
JWT_EXPIRES_IN=24h

# MinIO (armazenamento de objetos compativel com S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# E-mail
# Com o Gmail, EMAIL_PASS deve ser uma senha de app de 16 caracteres,
# nunca a senha da conta.
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=usuario@example.com
EMAIL_PASS=CHANGE_ME
EMAIL_FROM_NAME="SARA - Donaduzzi"
EMAIL_FROM_ADDRESS=nao-responda@example.com

# Frontend
FRONTEND_URL=http://localhost:3000
