{
  "name": "sara-api",
  "version": "1.0.0",
  "description": "Backend do SARA, sistema de submissão e avaliação por pares de artigos acadêmicos, com módulo OAI-PMH 2.0 e recomendação semântica de avaliadores",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:old": "nodemon src/server.ts",
    "prisma:generate-all": "prisma generate && bunx prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-and-seed": "bunx prisma migrate reset --force && bun run db:seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "repro:harvest": "python scripts/harvest_sol.py",
    "repro:dataset": "python scripts/build_dataset_sol.py",
    "repro:experiment": "bun scripts/run-experiment-sol.ts",
    "repro:validate-oai": "python scripts/validate-oai.py"
  },
  "keywords": [
    "peer-review",
    "oai-pmh",
    "dublin-core",
    "reviewer-assignment",
    "sentence-embeddings",
    "open-science"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SARA-Donaduzzi/sara-api.git"
  },
  "bugs": {
    "url": "https://github.com/SARA-Donaduzzi/sara-api/issues"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.5",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.3",
    "uuid": "^11.1.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.29",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prisma": "^6.9.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
