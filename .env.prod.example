# =============================================================================
# PRODUÇÃO — Copie para .env.prod e preencha os valores reais
# NUNCA commite .env.prod no git
# =============================================================================

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=sara_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=sara_db
DATABASE_URL=postgresql://sara_user:TROQUE_POR_SENHA_FORTE@postgres:5432/sara_db?schema=public

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=TROQUE_POR_SECRET_DE_64_CHARS_MINIMO
JWT_EXPIRES_IN=24h

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=sara_minio_admin
MINIO_ROOT_PASSWORD=TROQUE_POR_SENHA_FORTE
MINIO_ENDPOINT=sara_minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sara_minio_admin
MINIO_SECRET_KEY=TROQUE_POR_SENHA_FORTE

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=usuario@example.com
EMAIL_PASS=SENHA_DE_APP_16_CHARS
EMAIL_FROM_NAME="SARA - Donaduzzi"
EMAIL_FROM_ADDRESS=nao-responda@example.com

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://SEU_DOMINIO_FRONTEND
